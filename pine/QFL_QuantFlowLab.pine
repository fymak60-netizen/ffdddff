// This source code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// © QFlow Lab
//
// ═══════════════════════════════════════════════════════════════════════════
//  QFlow LAB — مختبر التدفق الكمي
//  Hurst × Entropy × Order-Flow  —  مبنية على OHLCV فقط (مفيش Level-2)
// ═══════════════════════════════════════════════════════════════════════════
//
//  الفكرة اللي مبني عليها المؤشر:
//  أغلب المؤشرات بتسأل "السعر رايح فين؟". المؤشر ده بيسأل سؤال مختلف تمامًا:
//      «هل السوق ده قابل للتنبؤ أصلًا دلوقتي؟ ولو آه — هل أنا بتاجر
//        مع الفلوس المطّلعة ولا ضدها؟ وهل السيولة تسمح إني آخد الصفقة؟»
//
//  ثلاث محاور مستقلة تمامًا عن بعض:
//    ① الاستمرارية  — Hurst (Variance-Ratio متعدد الآفاق)
//    ② الإنتروبي     — Permutation + Shannon (نظام مقابل ضجيج)
//    ③ التدفق        — VPIN على «ساعة الحجم» + OFI + Kyle λ + Amihud
//                        + سبريد Corwin-Schultz المُقدَّر من High/Low
//
//  المحاور الثلاثة بيرسموا «فضاء طور» (Phase Space) والآلة بتحدد النظام:
//      ترند  → نتاجر مع التدفق       |   ارتداد → نعكس الحركة
//      ضجيج  → مفيش صفقة خالص        (ده أهم قرار في المؤشر كله)
//
//  بعده بييجي الـ Meta-labeling: مش "فيه إشارة؟" لكن "الإشارة دي تستاهل؟"
//  وبعده الحواجز الثلاثة (وقف / هدف / وقت) وإدارة حجم بالـ 1%.
//
//  ⚠ مفيش أي repaint: كل القيم بتتحسب على شموع مُغلقة، وقيم الفريم الأكبر
//    بتيجي بـ [1] offset مع lookahead_on.
//
//  المراجع: Easley/Lopez de Prado/O'Hara (BVC + VPIN) · Andersen & Bondarenko
//  (VPIN المُوقّع) · Cont/Kukanov/Stoikov (OFI) · Kyle (1985) · Amihud (2002)
//  · Corwin & Schultz (2012) · Bandt & Pompe (2002) · Hurst/Lo (Variance Ratio)
//  · Kaufman (1995) · Lopez de Prado (2018: Meta-labeling + Triple Barrier)
// ═══════════════════════════════════════════════════════════════════════════

//@version=6
indicator("QFlow LAB — مختبر التدفق الكمي  [Hurst × Entropy × Order Flow]",
     shorttitle      = "QFL·LAB",
     overlay         = true,
     max_labels_count = 500,
     max_lines_count  = 500,
     max_boxes_count  = 200)

// ─────────────────────────────────────────────────────────────────────────
// ① المدخلات
// ─────────────────────────────────────────────────────────────────────────
G1 = "① الميكروستركشر (Microstructure)"
sigLen    = input.int  (20,   "σ للعوائد — نافذة BVC",        minval=5,    maxval=200, group=G1)
bucketLen = input.int  (20,   "متوسط الحجم — نافذة",          minval=5,    maxval=200, group=G1)
bucketMul = input.float(0.5,  "حجم الدلو  (× متوسط الشمعة)",  minval=0.05, maxval=5.0, step=0.05, group=G1)
vpinWin   = input.int  (50,   "عدد الدِلاء في نافذة VPIN",    minval=10,   maxval=200, group=G1)
ofiLen    = input.int  (20,   "نافذة OFI",                    minval=5,    maxval=200, group=G1)
lamLen    = input.int  (30,   "نافذة Kyle λ",                 minval=10,   maxval=200, group=G1)
illLen    = input.int  (20,   "نافذة Amihud",                 minval=5,    maxval=200, group=G1)

G2 = "② هندسة المعلومات"
hurstLen  = input.int  (100,  "نافذة Hurst",                  minval=30,   maxval=500, group=G2)
peLen     = input.int  (60,   "نافذة Permutation Entropy",    minval=20,   maxval=300, group=G2)
shLen     = input.int  (60,   "نافذة Shannon Entropy",        minval=20,   maxval=300, group=G2)
erLen     = input.int  (20,   "نافذة Efficiency Ratio",       minval=5,    maxval=100, group=G2)
rankLen   = input.int  (150,  "نافذة الـ Percentile Rank",    minval=50,   maxval=500, group=G2)

G3 = "③ آلة الأنظمة (Regime Machine)"
hTrend    = input.float(0.53, "Hurst ≥  → نظام ترند",         minval=0.50, maxval=0.70, step=0.01, group=G3)
hRevert   = input.float(0.47, "Hurst ≤  → نظام ارتداد",       minval=0.30, maxval=0.50, step=0.01, group=G3)
peMax     = input.float(40.0, "رتبة الإنتروبي ≤ → ترند (%)",  minval=5,    maxval=95,  group=G3)
peMin     = input.float(60.0, "رتبة الإنتروبي ≥ → ارتداد (%)", minval=5,    maxval=95,  group=G3)
erMin     = input.float(0.28, "Efficiency Ratio ≥ → ترند",    minval=0.05, maxval=0.90, step=0.01, group=G3)
confirmN  = input.int  (3,    "شموع تأكيد قبل تغيير النظام",  minval=1,    maxval=20,  group=G3)

G4 = "④ الزناد والفلتر"
amaLen    = input.int  (20,   "طول الخط المتكيّف (AMA)",      minval=5,    maxval=100, group=G4)
entryWin  = input.int  (6,    "نافذة الدخول بعد الاختراق",    minval=0,    maxval=30,  group=G4)
flowMin   = input.float(0.05, "أدنى تدفق مُوقّع (VPIN)",      minval=0.0,  maxval=0.5, step=0.01, group=G4)
zRev      = input.float(2.0,  "حدّ الارتداد (z)",             minval=0.5,  maxval=4.0, step=0.1, group=G4)
minMeta   = input.float(55.0, "أدنى Meta-Score للدخول",       minval=0,    maxval=95,  group=G4)
atrZMax   = input.float(2.2,  "أقصى ATR-z للدخول",            minval=0.5,  maxval=5.0, step=0.1, group=G4)
shockZ    = input.float(2.5,  "ATR-z = صدمة ⇒ ممنوع دخول",    minval=1.0,  maxval=6.0, step=0.1, group=G4)

G5 = "⑤ الفريم الأكبر (HTF)"
htfTf     = input.timeframe("240", "فريم الاتجاه",                       group=G5)
htfFlowOn = input.bool (true, "اشتراط توافق تدفق الفريم الأكبر",          group=G5)

G6 = "⑥ إدارة الصفقة والمال"
slMult    = input.float(1.6,  "الوقف  (× ATR)",               minval=0.3,  maxval=6.0, step=0.1, group=G6)
rr        = input.float(1.8,  "الهدف  (Risk : Reward)",       minval=0.5,  maxval=6.0, step=0.1, group=G6)
maxBars   = input.int  (40,   "حدّ الوقت (شمعة)",             minval=5,    maxval=400, group=G6)
beAtR     = input.float(1.0,  "نقل الوقف للدخول بعد (R)",     minval=0.0,  maxval=3.0, step=0.1, group=G6)
eqStart   = input.float(10000,"رأس المال الافتراضي ($)",      minval=100,  group=G6)
riskPct   = input.float(1.0,  "المخاطرة في الصفقة (%)",       minval=0.1,  maxval=5.0, step=0.1, group=G6)
contrVal  = input.float(100.0,"قيمة العقد (الدهب/فوركس = 100)", minval=1,   group=G6)
simOn     = input.bool (true, "تشغيل المحاكي الداخلي للأرقام", group=G6)

G7 = "⑦ الجلسات (مهم للدهب والفوركس)"
sessOn    = input.bool (true, "التداول داخل الجلسة دي بس",    group=G7)
sessStr   = input.session("0700-1630", "جلسة التداول (GMT)",  group=G7)
blkOn     = input.bool (true, "حظر فترة الرول أوفر 21:45–22:15 GMT", group=G7)

G8 = "⑧ الشكل والأنيميشن"
showHud   = input.bool (true,  "لوحة المختبر (HUD)",          group=G8)
showPhase = input.bool (true,  "خريطة فضاء الطور",            group=G8)
showLog   = input.bool (true,  "سجل آخر الصفقات",             group=G8)
showWires = input.bool (true,  "خطوط الوقف/الهدف للصفقة النشطة", group=G8)
animOn    = input.bool (true,  "الأنيميشن (نبض + مسح ضوئي)",  group=G8)
bandMult  = input.float(2.0,   "عرض الحزام (× ATR)",          minval=0.5, maxval=6.0, step=0.1, group=G8)

// ─────────────────────────────────────────────────────────────────────────
// دوال مساعدة
// ─────────────────────────────────────────────────────────────────────────

// Normal CDF — تقريب Abramowitz & Stegun 7.1.26 (خطأ ≈ 1.5e-7)
f_erf(float x) =>
    float s  = x < 0 ? -1.0 : 1.0
    float ax = math.abs(x)
    float t  = 1.0 / (1.0 + 0.3275911 * ax)
    float y  = 1.0 - ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * math.exp(-ax * ax)
    s * y

f_ncdf(float z) => 0.5 * (1.0 + f_erf(z / math.sqrt(2.0)))

// الرتبة المئوية داخل تاريخ السلسلة نفسه — ده اللي بيخلي المؤشر يضبط نفسه
// على كل أداة وفريم لوحده بدل حدود مطلقة ثابتة.
f_pctr(series float src, simple int len) =>
    float below = 0.0
    float tot   = 0.0
    for i = 0 to len - 1
        float v = src[i]
        if not na(v)
            tot += 1.0
            if v < src
                below += 1.0
    tot > 1 ? 100.0 * below / tot : na

// Hurst عن طريق Variance-Ratio على 3 آفاق (k = 2, 4, 8) + انحدار ln VR على ln k.
// ملاحظة تنفيذية: استخدمنا ta.variance في أماكن ثابتة (مش جوه loop) لأن دوال
// ta.* ليها حالة داخلية بتبوظ لو اتنادت أكتر من مرة في نفس الشمعة.
f_hurst(simple int win) =>
    float p  = math.log(close)
    float v1 = ta.variance(p - p[1], win)
    float v2 = ta.variance(p - p[2], win)
    float v4 = ta.variance(p - p[4], win)
    float v8 = ta.variance(p - p[8], win)
    float h  = 0.5
    if v1 > 0 and v2 > 0 and v4 > 0 and v8 > 0
        float y1 = math.log(v2 / (2.0 * v1))
        float y2 = math.log(v4 / (4.0 * v1))
        float y3 = math.log(v8 / (8.0 * v1))
        float xm = 1.3862943611198906
        float ym = (y1 + y2 + y3) / 3.0
        float dx1 = 0.6931471805599453 - xm
        float dx2 = 1.3862943611198906 - xm
        float dx3 = 2.0794415416798359 - xm
        float sxx = dx1 * dx1 + dx2 * dx2 + dx3 * dx3
        float sxy = dx1 * (y1 - ym) + dx2 * (y2 - ym) + dx3 * (y3 - ym)
        if sxx > 0
            h := math.max(0.0, math.min(1.0, 0.5 * (sxy / sxx + 1.0)))
    h

// Permutation Entropy (Bandt & Pompe) — كود 3-bit حقني (injective)
f_permEntropy(series float r, simple int len) =>
    array<float> cnt = array.new<float>(8, 0.0)
    float used = 0.0
    for i = 0 to len - 1
        float a = r[i]
        float b = r[i + 1]
        float c = r[i + 2]
        if not na(a) and not na(b) and not na(c)
            int code = (a > b ? 1 : 0) + (a > c ? 2 : 0) + (b > c ? 4 : 0)
            array.set(cnt, code, array.get(cnt, code) + 1.0)
            used += 1.0
    float H = 0.0
    if used > 1
        for j = 0 to 7
            float p = array.get(cnt, j) / used
            if p > 0
                H -= p * math.log(p)
    H / 1.791759469228055

// Shannon Entropy لعوائد مقسّمة على 8 صناديق (±4σ)
f_shannon(series float r, series float sd, simple int len) =>
    array<float> cnt = array.new<float>(8, 0.0)
    float used = 0.0
    for i = 0 to len - 1
        float v = r[i]
        float s = sd[i]
        if not na(v) and not na(s) and s > 0
            int b = int(math.floor(v / s + 4.0))
            b := math.max(0, math.min(7, b))
            array.set(cnt, b, array.get(cnt, b) + 1.0)
            used += 1.0
    float H = 0.0
    if used > 1
        for j = 0 to 7
            float p = array.get(cnt, j) / used
            if p > 0
                H -= p * math.log(p)
    H / 2.0794415416798359

// Kaufman Efficiency Ratio
f_er(simple int len) =>
    float net  = math.abs(close - close[len])
    float path = ta.sum(math.abs(close - close[1]), len)
    path > 0 ? net / path : 0.0

// Kaufman Adaptive Moving Average
f_ama(simple int len, simple int fast, simple int slow) =>
    float er  = f_er(len)
    float fsc = 2.0 / (fast + 1.0)
    float ssc = 2.0 / (slow + 1.0)
    float a   = math.pow(er * (fsc - ssc) + ssc, 2)
    float out = na
    out := na(out[1]) ? close : a * close + (1.0 - a) * nz(out[1])
    out

// سبريد Corwin & Schultz (2012) — من High/Low بس
f_csSpread() =>
    float hl0 = high / low
    float hl1 = high[1] / low[1]
    float s   = 0.0
    if hl0 > 1.0 and hl1 > 1.0
        float beta  = 3.8284271247461903 * (math.log(hl0) * math.log(hl0) + math.log(hl1) * math.log(hl1))
        float gamma = math.log(high / low[1])
        gamma := gamma * gamma
        float den   = 0.1715728752538099
        float alpha = (math.sqrt(2.0 * beta) - math.sqrt(beta)) / den - math.sqrt(beta / den) + math.sqrt(gamma / den)
        float ea    = math.exp(alpha)
        s := math.max(0.0, math.min(1.0, 2.0 * (ea - 1.0) / (1.0 + ea)))
    s

// شريط الـ gauge للوحة
f_gauge(float v) =>
    int n = int(math.round(math.max(0.0, math.min(100.0, v)) / 10.0))
    string s = ""
    for i = 1 to 10
        s += i <= n ? "█" : "░"
    s

// ─────────────────────────────────────────────────────────────────────────
// الطبقة 0 — الميكروستركشر من OHLCV
// ─────────────────────────────────────────────────────────────────────────
float ret  = math.log(close / close[1])
float sig  = math.max(1e-10, ta.stdev(ret, sigLen))
float zRet = sig > 0 ? ret / sig : 0.0

// Bulk Volume Classification: بنقسّم حجم الشمعة من غير أي بيانات صفقات
float buyVol  = volume * f_ncdf(zRet)
float sellVol = volume - buyVol
float sgnVol  = buyVol - sellVol

// VPIN على «ساعة الحجم»: بنملأ دِلاء ثابتة الحجم (مش شموع ثابتة الزمن).
// دي أهم فرق بين المؤشر ده وبين أي VPIN معمول من شموع زمنية.
float bktSize = math.max(1.0, nz(ta.sma(volume, bucketLen)) * bucketMul)
var float accB = 0.0
var float accS = 0.0
var float accV = 0.0
var array<float> qB = array.new<float>()
var array<float> qS = array.new<float>()

float remB = buyVol
float remS = sellVol
int   guard = 0
while guard < 8 and (remB + remS) > 0
    float inc  = remB + remS
    float take = math.min(bktSize - accV, inc)
    float frac = inc > 0 ? take / inc : 0.0
    accB += remB * frac
    accS += remS * frac
    remB -= remB * frac
    remS -= remS * frac
    accV += take
    if accV >= bktSize * 0.999999
        array.push(qB, accB)
        array.push(qS, accS)
        accB := 0.0
        accS := 0.0
        accV := 0.0
        if array.size(qB) > vpinWin
            array.shift(qB)
            array.shift(qS)
    guard += 1

float vpinAbs = na
float vpinSig = na
if array.size(qB) >= vpinWin
    float tb  = array.sum(qB)
    float ts  = array.sum(qS)
    float tv  = tb + ts
    float imb = 0.0
    for i = 0 to array.size(qB) - 1
        imb += math.abs(array.get(qB, i) - array.get(qS, i))
    if tv > 0
        vpinAbs := imb / tv
        vpinSig := (tb - ts) / tv

// OFI (Cont/Kukanov/Stoikov) — نسخة مُطبّعة
// ملاحظة: نداءات ta.sum بره الشرط — لو اتحطّت جوه ternary وكانت الشرط false
// مرة واحدة، الحالة الداخلية للدالة بتبوظ لبقية الشارت.
float tvol  = ta.sum(volume,  ofiLen)
float tBuy  = ta.sum(buyVol,  ofiLen)
float tSell = ta.sum(sellVol, ofiLen)
float flow  = tvol > 0 ? (tBuy - tSell) / tvol : 0.0

// Kyle λ = ميل (Close−Open) على الحجم المُوقّع
float lamVar = ta.variance(sgnVol, lamLen)
float lamCov = ta.covariance(close - open, sgnVol, lamLen)
float lam    = lamVar > 0 ? lamCov / lamVar : na
// مؤشر نسبي لأثر السعر (مش bps حقيقية) — اللي يهمنا هو رتبته المئوية
float lamBps = na(lam) ? na : lam * close * 10000.0

// Amihud illiquidity
float illiq = ta.sma(math.abs(ret) / math.max(close * volume, 1e-9), illLen)

// السبريد المُقدَّر + ATR
float spr   = f_csSpread()
float sprBp = spr * 10000.0
float atr   = ta.atr(14)
float atrS  = ta.sma(atr, 100)
float atrSd = ta.stdev(atr, 100)
float atrZ  = atrSd > 0 ? (atr - atrS) / atrSd : 0.0

// ─────────────────────────────────────────────────────────────────────────
// الطبقة 1 — هندسة المعلومات
// ─────────────────────────────────────────────────────────────────────────
float hurst = f_hurst(hurstLen)
float pe    = f_permEntropy(ret, peLen)
float sh    = f_shannon(ret, sig, shLen)
float er    = f_er(erLen)

// رُتب مئوية (الضبط الذاتي)
float rHurst = f_pctr(hurst,    rankLen)
float rPe    = f_pctr(pe,       rankLen)
float rSh    = f_pctr(sh,       rankLen)
float rEr    = f_pctr(er,       rankLen)
float rVabs  = f_pctr(vpinAbs,  rankLen)
float rSpr   = f_pctr(sprBp,    rankLen)
float rIll   = f_pctr(illiq,    rankLen)
float rLam   = f_pctr(math.abs(lam), rankLen)

// ─────────────────────────────────────────────────────────────────────────
// الطبقة 2 — الفريم الأكبر + آلة الأنظمة
// ─────────────────────────────────────────────────────────────────────────
// كل القيم جوه الدالة بـ [1] offset ⇒ شموع مُغلقة بس ⇒ مفيش repaint
f_htfPack() =>
    float r1  = math.log(close[1] / close[2])
    float sd  = ta.stdev(r1, sigLen)
    float bv  = volume[1] * f_ncdf(sd > 0 ? r1 / sd : 0.0)
    float fl  = volume[1] > 0 ? (2.0 * bv - volume[1]) / volume[1] : 0.0
    float net = math.abs(close[1] - close[1 + erLen])
    float pth = ta.sum(math.abs(close[1] - close[2]), erLen)
    float e   = pth > 0 ? net / pth : 0.0
    float sl  = ta.ema(close[1], 20) - ta.ema(close[1], 50)
    [fl, e, sl]

[htfFlow, htfEr, htfSlope] = request.security(syminfo.tickerid, htfTf, f_htfPack(), barmerge.gaps_off, barmerge.lookahead_on)

float amaLine = f_ama(amaLen, 2, 30)
float zres    = atr > 0 ? (close - amaLine) / atr : na

// آلة الأنظمة مع hysteresis (ممنوع الرفرفة)
var int   state = 0
var int   cand  = 0
var int   run   = 0
int rawState = 0
if not na(hurst) and not na(rPe) and not na(er)
    if hurst >= hTrend and rPe <= peMax and er >= erMin
        rawState := 1
    else if hurst <= hRevert and rPe >= peMin and er < erMin
        rawState := -1

if rawState == state
    cand  := state
    run   := 0
else
    if rawState == cand
        run += 1
    else
        cand := rawState
        run  := 1
    if run >= confirmN
        state := cand
        run   := 0

// ─────────────────────────────────────────────────────────────────────────
// الطبقة 3 — الزناد
// ─────────────────────────────────────────────────────────────────────────
bool crossUp = ta.crossover(close, amaLine)
bool crossDn = ta.crossunder(close, amaLine)
int  sinceUp = ta.barssince(crossUp)
int  sinceDn = ta.barssince(crossDn)

int sigDir = 0
if state == 1 and not na(sinceUp) and sinceUp <= entryWin and close > amaLine and not na(vpinSig) and vpinSig > flowMin
    sigDir := 1
else if state == -1 and not na(sinceDn) and sinceDn <= entryWin and close < amaLine and not na(vpinSig) and vpinSig < -flowMin
    sigDir := -1
else if state == -1 and not na(zres) and zres < -zRev
    sigDir := 1
else if state == -1 and not na(zres) and zres > zRev
    sigDir := -1

// ─────────────────────────────────────────────────────────────────────────
// الطبقة 4 — الـ Meta-Label  + بوابات الجلسة
// ─────────────────────────────────────────────────────────────────────────
int   hh     = hour(time, "GMT")
int   mm     = minute(time, "GMT")
bool blk     = blkOn and ((hh == 21 and mm >= 45) or (hh == 22 and mm < 15))
bool inSess  = sessOn ? not na(time(timeframe.period, sessStr, "GMT")) : true
bool sessOk  = inSess and not blk
bool shock   = atrZ > shockZ

f_meta(int mode, float vSig, float vAbsP, float sprP, float illP, float lamP, float aZ, float erP, bool hOk, bool sOk, bool shk) =>
    float sc = 0.0
    if mode != 0 and sOk and not shk
        float fl = 50.0 + 50.0 * math.max(-1.0, math.min(1.0, vSig))
        fl := mode < 0 ? 100.0 - fl : fl
        float erc = mode > 0 ? erP : 100.0 - erP
        float liq = 100.0 - (0.45 * sprP + 0.30 * illP + 0.25 * lamP)
        float vol = math.max(0.0, 100.0 - 45.0 * math.abs(aZ))
        sc := 0.30 * fl + 0.22 * erc + 0.18 * liq + 0.12 * vol + 0.18 * (hOk ? 100.0 : 0.0)
        if vAbsP > 97.0
            sc *= 0.5
    math.max(0.0, math.min(100.0, sc))

bool htfOk = not htfFlowOn or na(htfFlow) or (sigDir > 0 ? htfFlow > 0 : htfFlow < 0)
float meta = f_meta(state, nz(vpinSig), nz(rVabs), nz(rSpr), nz(rIll), nz(rLam), atrZ, nz(rEr), htfOk, sessOk, shock)

bool goLong  = sigDir ==  1 and meta >= minMeta and math.abs(atrZ) <= atrZMax
bool goShort = sigDir == -1 and meta >= minMeta and math.abs(atrZ) <= atrZMax

// ─────────────────────────────────────────────────────────────────────────
// الطبقة 5 — الحواجز الثلاثة + المحاكي الداخلي + إدارة الحجم
// ─────────────────────────────────────────────────────────────────────────
float slDist = atr * slMult
float riskAmt = eqStart * riskPct / 100.0
float lots    = slDist > 0 ? riskAmt / (slDist * contrVal) : 0.0

var int    tDir   = 0
var float  tEntry = na
var float  tSL    = na
var float  tTP    = na
var float  tSize  = na
var int    tStart = na
var bool   tBE    = false

var int    nTr   = 0
var int    nWin  = 0
var float  pnlS  = 0.0
var float  eq     = eqStart
var float  eqPk   = eqStart
var float  maxDD  = 0.0
var float  lastR  = 0.0
var string lastWhy = "—"
var float  grossW = 0.0
var float  grossL = 0.0

var array<float>  rHist = array.new<float>()
var array<string> wHist = array.new<string>()

bool fired = false
if simOn and tDir == 0 and (goLong or goShort) and not na(atr) and slDist > 0
    tDir   := goLong ? 1 : -1
    tEntry := close
    tSL    := close - tDir * slDist
    tTP    := close + tDir * slDist * rr
    tSize  := riskAmt / (slDist * contrVal)
    tStart := bar_index
    tBE    := false
    fired  := true

bool closedTrade = false
if simOn and tDir != 0 and not fired and bar_index > tStart
    float fav = (high - tEntry) * tDir
    if not tBE and beAtR > 0 and fav >= slDist * beAtR
        tSL  := tEntry
        tBE  := true
    bool hitSL = tDir > 0 ? low <= tSL : high >= tSL
    bool hitTP = tDir > 0 ? high >= tTP : low <= tTP
    bool timed = bar_index - tStart >= maxBars
    float xP   = na
    string why = ""
    // لو الوقف والهدف اتلمسوا في نفس الشمعة بناخد الوقف (الأسوأ) — تحفّظًا
    if hitSL
        xP  := tSL
        why := "STOP"
    else if hitTP
        xP  := tTP
        why := "TP"
    else if timed
        xP  := close
        why := "TIME"
    if not na(xP)
        float pnl = (xP - tEntry) * tDir * tSize * contrVal
        float rm  = slDist > 0 ? (xP - tEntry) * tDir / slDist : 0.0
        nTr   += 1
        nWin  += pnl > 0 ? 1 : 0
        pnlS  += pnl
        eq    += pnl
        eqPk   := math.max(eqPk, eq)
        maxDD  := math.max(maxDD, eqPk - eq)
        lastR  := rm
        lastWhy := why
        grossW += pnl > 0 ? pnl : 0.0
        grossL += pnl < 0 ? -pnl : 0.0
        array.push(rHist, rm)
        array.push(wHist, why)
        if array.size(rHist) > 12
            array.shift(rHist)
            array.shift(wHist)
        tDir := 0
        closedTrade := true

float winRate = nTr > 0 ? 100.0 * nWin / nTr : 0.0
float expR    = nTr > 0 ? pnlS / math.max(riskAmt, 1e-9) / nTr : 0.0
float expUsd  = nTr > 0 ? pnlS / nTr : 0.0
float pf      = grossL > 0 ? grossW / grossL : 0.0
float retPct  = eqStart > 0 ? (eq - eqStart) / eqStart * 100.0 : 0.0

// ─────────────────────────────────────────────────────────────────────────
// الرسم على الشارت
// ─────────────────────────────────────────────────────────────────────────
color cTrend = color.new(#00e5ff, 0)
color cRev   = color.new(#ff9f1c, 0)
color cIdle  = color.new(#7a8699, 0)
color cBull  = color.new(#26ff8c, 0)
color cBear  = color.new(#ff4d6d, 0)
color lineC  = state == 1 ? cTrend : state == -1 ? cRev : cIdle

plot(amaLine, "الخط المتكيّف", lineC, 2)
plot(amaLine + atr * bandMult, "حد علوي", color.new(lineC, 78), 1)
plot(amaLine - atr * bandMult, "حد سفلي", color.new(lineC, 78), 1)
bgcolor(state == 1 ? color.new(cTrend, 94) : state == -1 ? color.new(cRev, 94) : na, title="خلفية النظام")

plotshape(goLong  and tDir == 1,  "شراء",  shape.triangleup,   location.belowbar, cBull, size = size.small)
plotshape(goShort and tDir == -1, "بيع",   shape.triangledown, location.abovebar, cBear, size = size.small)
plotshape(closedTrade and lastR > 0, "ربح",  shape.circle, location.belowbar, color.new(cBull, 45), size = size.tiny)
plotshape(closedTrade and lastR <= 0, "خسارة", shape.xcross, location.abovebar, color.new(cBear, 45), size = size.tiny)

var line slLine = na
var line tpLine = na
if showWires and barstate.islast
    if not na(slLine)
        line.delete(slLine)
    if not na(tpLine)
        line.delete(tpLine)
    if tDir != 0
        slLine := line.new(tStart, tSL, bar_index + 8, tSL, color = color.new(cBear, 0), width = 2, style = line.style_dashed)
        tpLine := line.new(tStart, tTP, bar_index + 8, tTP, color = color.new(cBull, 0), width = 2, style = line.style_dashed)

// ─────────────────────────────────────────────────────────────────────────
// الأنيميشن + لوحة المختبر
// ─────────────────────────────────────────────────────────────────────────
var int frame = 0
frame := animOn ? (barstate.isrealtime ? (frame + 1) % 997 : bar_index % 997) : 0
float pulse = animOn ? 0.5 + 0.5 * math.sin(frame * 0.45) : 0.5
int   ph    = frame % 4
string core = ph == 0 ? "◉" : ph == 1 ? "◎" : ph == 2 ? "◍" : "◌"
int   scan  = frame % 9

string stName = state == 1 ? "TREND · ترند" : state == -1 ? "REVERT · ارتداد" : "NOISE · ضجيج"
string dirTxt = tDir == 1 ? "LONG ▲" : tDir == -1 ? "SHORT ▼" : "FLAT —"
color  stCol  = state == 1 ? cTrend : state == -1 ? cRev : cIdle

// مساعدات تنسيق بصيغة ثابتة (const) — str.tostring في Pine محتاج format ثابت،
// فبنستخدم دوال صغيرة بدل ما نمرّر الصيغة كـ parameter.
f1(float v) => na(v) ? "—" : str.tostring(v, "#.#")
f2(float v) => na(v) ? "—" : str.tostring(v, "#.##")
f3(float v) => na(v) ? "—" : str.tostring(v, "#.###")
f4(float v) => na(v) ? "—" : str.tostring(v, "#.####")

var table hud = table.new(position.top_right, 3, 20,
     bgcolor = color.new(#070b14, 8), border_color = color.new(#1d2a44, 30),
     border_width = 1, frame_color = color.new(#2b6cff, 40), frame_width = 2)

if showHud and barstate.islast
    table.cell(hud, 0, 0, core + "  QFlow LAB", text_color = color.rgb(0, 229, 255, int(30 * pulse)),
         bgcolor = color.new(#0b1220, 0), text_size = size.normal)
    table.cell(hud, 1, 0, stName, text_color = color.new(stCol, int(40 * pulse)),
         bgcolor = color.new(#0b1220, 0), text_size = size.small)
    table.cell(hud, 2, 0, dirTxt, text_color = tDir != 0 ? color.white : color.new(#7a8699, 0),
         bgcolor = color.new(#0b1220, 0), text_size = size.small)

    table.cell(hud, 0, 1, "① الاستمرارية", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(hud, 1, 1, "Hurst  " + f3(hurst), text_color = hurst >= hTrend ? cTrend : hurst <= hRevert ? cRev : color.white, bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(hud, 2, 1, "رتبة " + f1(rHurst) + "%", text_color = color.new(#9fb2d8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)

    table.cell(hud, 0, 2, "② الإنتروبي", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(hud, 1, 2, "Perm  " + f3(pe), text_color = color.white, bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(hud, 2, 2, "رتبة " + f1(rPe) + "%", text_color = color.new(#9fb2d8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)

    table.cell(hud, 0, 3, "   Shannon", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(hud, 1, 3, "H  " + f3(sh), text_color = color.white, bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(hud, 2, 3, "رتبة " + f1(rSh) + "%", text_color = color.new(#9fb2d8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)

    table.cell(hud, 0, 4, "③ الكفاءة", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(hud, 1, 4, "ER  " + f3(er), text_color = color.white, bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(hud, 2, 4, "رتبة " + f1(rEr) + "%", text_color = color.new(#9fb2d8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)

    table.cell(hud, 0, 5, "④ VPIN سمّية", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(hud, 1, 5, f3(vpinAbs), text_color = rVabs > 90 ? cBear : color.white, bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(hud, 2, 5, "رتبة " + f1(rVabs) + "%", text_color = color.new(#9fb2d8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)

    table.cell(hud, 0, 6, "⑤ VPIN اتجاه", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(hud, 1, 6, f3(vpinSig), text_color = nz(vpinSig) > 0 ? cBull : cBear, bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(hud, 2, 6, "OFI " + f2(flow), text_color = color.new(#9fb2d8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)

    table.cell(hud, 0, 7, "⑥ Kyle λ", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(hud, 1, 7, f4(lamBps) + " bp", text_color = color.white, bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(hud, 2, 7, "رتبة " + f1(rLam) + "%", text_color = color.new(#9fb2d8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)

    table.cell(hud, 0, 8, "⑦ Amihud", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(hud, 1, 8, f2(illiq * 1e9) + "e-9", text_color = color.white, bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(hud, 2, 8, "رتبة " + f1(rIll) + "%", text_color = color.new(#9fb2d8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)

    table.cell(hud, 0, 9, "⑧ السبريد المقدَّر", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(hud, 1, 9, f1(sprBp) + " bp", text_color = rSpr > 80 ? cBear : color.white, bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(hud, 2, 9, "رتبة " + f1(rSpr) + "%", text_color = color.new(#9fb2d8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)

    table.cell(hud, 0, 10, "⑨ التقلّب ATR-z", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(hud, 1, 10, f2(atrZ), text_color = math.abs(atrZ) > atrZMax ? cBear : color.white, bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(hud, 2, 10, "ATR " + f2(atr), text_color = color.new(#9fb2d8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)

    table.cell(hud, 0, 11, "⑩ الفريم الأكبر", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(hud, 1, 11, "تدفق " + f2(htfFlow), text_color = nz(htfFlow) > 0 ? cBull : cBear, bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(hud, 2, 11, "ER " + f2(htfEr), text_color = color.new(#9fb2d8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)

    table.cell(hud, 0, 12, "⑪ الجلسة", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(hud, 1, 12, sessOk ? "مفتوحة ✓" : blk ? "رول أوفر ✗" : "مقفولة ✗", text_color = sessOk ? cBull : cBear, bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(hud, 2, 12, shock ? "صدمة ⚡" : "عادي", text_color = shock ? cBear : color.new(#9fb2d8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)

    table.cell(hud, 0, 13, "META-SCORE", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#101a2e, 0), text_size = size.tiny)
    table.cell(hud, 1, 13, f1(meta) + " / 100", text_color = meta >= minMeta ? cBull : color.new(#9fb2d8, 0), bgcolor = color.new(#101a2e, 0), text_size = size.small)
    table.cell(hud, 2, 13, f_gauge(meta), text_color = color.rgb(0, 229, 255, int(45 * pulse)), bgcolor = color.new(#101a2e, 0), text_size = size.tiny)

    table.cell(hud, 0, 14, "⑫ الحجم", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#101a2e, 0), text_size = size.tiny)
    table.cell(hud, 1, 14, f3(lots) + " lot", text_color = color.white, bgcolor = color.new(#101a2e, 0), text_size = size.tiny)
    table.cell(hud, 2, 14, "مخاطرة $" + f1(riskAmt), text_color = color.new(#ffd166, 0), bgcolor = color.new(#101a2e, 0), text_size = size.tiny)

    table.cell(hud, 0, 15, "⑬ المحاكاة", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#101a2e, 0), text_size = size.tiny)
    table.cell(hud, 1, 15, str.tostring(nTr) + " صفقة · نجاح " + f1(winRate) + "%", text_color = color.white, bgcolor = color.new(#101a2e, 0), text_size = size.tiny)
    table.cell(hud, 2, 15, "PF " + f2(pf), text_color = pf >= 1.3 ? cBull : pf > 0 ? cBear : color.new(#9fb2d8, 0), bgcolor = color.new(#101a2e, 0), text_size = size.tiny)

    table.cell(hud, 0, 16, "⑭ التوقع", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#101a2e, 0), text_size = size.tiny)
    table.cell(hud, 1, 16, f3(expR) + "R", text_color = expR > 0 ? cBull : cBear, bgcolor = color.new(#101a2e, 0), text_size = size.tiny)
    table.cell(hud, 2, 16, "$" + f1(expUsd) + "/صفقة", text_color = expUsd > 0 ? cBull : cBear, bgcolor = color.new(#101a2e, 0), text_size = size.tiny)

    table.cell(hud, 0, 17, "⑮ الرصيد", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#101a2e, 0), text_size = size.tiny)
    table.cell(hud, 1, 17, "$" + f1(eq) + " (" + f1(retPct) + "%)", text_color = eq >= eqStart ? cBull : cBear, bgcolor = color.new(#101a2e, 0), text_size = size.tiny)
    table.cell(hud, 2, 17, "أقصى DD $" + f1(maxDD), text_color = color.new(#ffd166, 0), bgcolor = color.new(#101a2e, 0), text_size = size.tiny)

    if tDir != 0
        table.cell(hud, 0, 18, "صفقة نشطة", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#132038, 0), text_size = size.tiny)
        table.cell(hud, 1, 18, "دخول " + str.tostring(tEntry, format.mintick), text_color = color.white, bgcolor = color.new(#132038, 0), text_size = size.tiny)
        table.cell(hud, 2, 18, (tBE ? "وقف=دخول " : "وقف ") + str.tostring(tSL, format.mintick), text_color = cBear, bgcolor = color.new(#132038, 0), text_size = size.tiny)
        table.cell(hud, 0, 19, "", bgcolor = color.new(#132038, 0), text_size = size.tiny)
        table.cell(hud, 1, 19, "هدف " + str.tostring(tTP, format.mintick), text_color = cBull, bgcolor = color.new(#132038, 0), text_size = size.tiny)
        table.cell(hud, 2, 19, "باقي " + str.tostring(math.max(0, maxBars - (bar_index - tStart))) + " شمعة", text_color = color.new(#9fb2d8, 0), bgcolor = color.new(#132038, 0), text_size = size.tiny)

// ── خريطة فضاء الطور: المحور الأفقي = Hurst، الرأسي = رتبة الإنتروبي ──────
var table phMap = table.new(position.bottom_right, 9, 8,
     bgcolor = color.new(#070b14, 10), border_color = color.new(#16233c, 40),
     border_width = 1, frame_color = color.new(#2b6cff, 55), frame_width = 1)

if showPhase and barstate.islast
    table.cell(phMap, 0, 0, "فضاء الطور", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#0b1220, 0), text_size = size.tiny)
    table.cell(phMap, 1, 0, "← ارتداد", text_color = cRev, bgcolor = color.new(#0b1220, 0), text_size = size.tiny)
    table.cell(phMap, 5, 0, "عشوائي", text_color = color.new(#7a8699, 0), bgcolor = color.new(#0b1220, 0), text_size = size.tiny)
    table.cell(phMap, 8, 0, "ترند →", text_color = cTrend, bgcolor = color.new(#0b1220, 0), text_size = size.tiny)

    int pc = na(hurst) ? -1 : int(math.max(0.0, math.min(8.0, math.floor((hurst - 0.30) / 0.05))))
    int pr = na(rPe) ? -1 : int(math.max(0.0, math.min(6.0, math.floor(rPe / 15.0))))

    for col = 0 to 8
        for row = 1 to 7
            int rr2 = row - 1
            bool isDot = col == pc and rr2 == pr
            bool isScan = animOn and col == scan
            float hMid = 0.30 + col * 0.05 + 0.025
            float eMid = rr2 * 15.0 + 7.5
            color base = hMid >= 0.525 ? color.new(cTrend, 88) : hMid <= 0.475 ? color.new(cRev, 88) : color.new(#3a4a6b, 88)
            if eMid > 55.0
                base := color.new(base, 94)
            color cellBg = base
            if isScan
                cellBg := color.new(color.white, 92)
            table.cell(phMap, col, row, isDot ? "●" : "",
                 text_color = color.rgb(255, 255, 255, int(20 + 60 * pulse)),
                 bgcolor = isDot ? color.rgb(0, 229, 255, int(30 + 35 * pulse)) : cellBg,
                 text_size = size.small)

// ── سجل آخر الصفقات ─────────────────────────────────────────────────────
var table logT = table.new(position.top_left, 4, 7,
     bgcolor = color.new(#070b14, 12), border_color = color.new(#16233c, 45),
     border_width = 1, frame_color = color.new(#2b6cff, 60), frame_width = 1)

if showLog and barstate.islast
    table.cell(logT, 0, 0, "#", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#0b1220, 0), text_size = size.tiny)
    table.cell(logT, 1, 0, "R", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#0b1220, 0), text_size = size.tiny)
    table.cell(logT, 2, 0, "$", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#0b1220, 0), text_size = size.tiny)
    table.cell(logT, 3, 0, "السبب", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#0b1220, 0), text_size = size.tiny)
    int nsz = array.size(rHist)
    for j = 0 to 5
        int idx = nsz - 1 - j
        if idx >= 0
            float rv = array.get(rHist, idx)
            table.cell(logT, 0, j + 1, str.tostring(nTr - j), text_color = color.new(#9fb2d8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
            table.cell(logT, 1, j + 1, str.tostring(rv, "#.##") + "R", text_color = rv > 0 ? cBull : cBear, bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
            table.cell(logT, 2, j + 1, str.tostring(rv * riskAmt, "#.#"), text_color = rv > 0 ? cBull : cBear, bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
            table.cell(logT, 3, j + 1, array.get(wHist, idx), text_color = color.new(#9fb2d8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)

// ── نبضة حية على آخر شمعة ────────────────────────────────────────────────
var label ping = na
if barstate.islast
    if not na(ping)
        label.delete(ping)
    string txt = core + "  " + stName + "  ·  META " + str.tostring(meta, "#.#")
    ping := label.new(bar_index + 2, close, txt,
         style = label.style_label_left, color = color.new(stCol, int(25 + 30 * pulse)),
         textcolor = color.white, size = size.small)

// ─────────────────────────────────────────────────────────────────────────
// التنبيهات
// ─────────────────────────────────────────────────────────────────────────
alertcondition(goLong,  "QFL · شراء",  "QFlow LAB: إشارة شراء — النظام {{ticker}} {{interval}}")
alertcondition(goShort, "QFL · بيع",   "QFlow LAB: إشارة بيع — {{ticker}} {{interval}}")
alertcondition(closedTrade and lastR > 0,  "QFL · إغلاق رابح", "QFlow LAB: الصفقة اتقفلت على ربح {{ticker}}")
alertcondition(closedTrade and lastR <= 0, "QFL · إغلاق خاسر", "QFlow LAB: الصفقة اتقفلت على خسارة {{ticker}}")
alertcondition(state == 1  and state[1] != 1,  "QFL · دخول نظام ترند",   "QFlow LAB: السوق دخل نظام ترند {{ticker}} {{interval}}")
alertcondition(state == -1 and state[1] != -1, "QFL · دخول نظام ارتداد", "QFlow LAB: السوق دخل نظام ارتداد {{ticker}} {{interval}}")
alertcondition(meta >= minMeta and meta[1] < minMeta, "QFL · META فوق الحد", "QFlow LAB: جودة الصفقة عدّت الحد {{ticker}}")
alertcondition(tDir != 0 and tBE and not tBE[1], "QFL · الوقف عند الدخول", "QFlow LAB: اتحرك الوقف لنقطة الدخول {{ticker}}")
