// ═══════════════════════════════════════════════════════════════════════════
//  QFlow LAB — نسخة الباك تست (Strategy)
// ═══════════════════════════════════════════════════════════════════════════
//  نفس المحرك بالظبط الموجود في `QFL_QuantFlowLab.pine` — نفس المعادلات،
//  نفس الطبقات، نفس العتبات. الفرق الوحيد إن دي strategy() مش indicator()،
//  عشان تختبرها في Strategy Tester بتاع TradingView وتشوف أرقام حقيقية
//  على بيانات حقيقية بدل أي رقم تقريبي.
//
//  الطريقة الصحيحة للاستخدام:
//    1) افتح الشارت على XAUUSD (أو أي أداة) على الفريم اللي هتتداوله.
//    2) علّق السكربت ده، وافتح تبويب "Strategy Tester".
//    3) جرّب أكتر من فريم وأكتر من أداة. لو النظام شغال على 3 أدوات
//       و3 فريمات مختلفة، ده دليل. لو شغال على واحد بس، ده حظ.
//    4) قارن الأرقام بالـ Deep Backtesting لو خطتك تسمح.
//
//  ⚠ الأرقام اللي هتشوفها هنا هي الحقيقة — مش الأرقام التقريبية في الملف
//    docs/trading_rules_ar.md. أي تعارض بينهم، صدّق الـ Strategy Tester.
// ═══════════════════════════════════════════════════════════════════════════

//@version=6
strategy("QFlow LAB — Strategy  [Hurst × Entropy × Order Flow]",
     shorttitle               = "QFL·STRAT",
     overlay                  = true,
     initial_capital          = 10000,
     default_qty_type         = strategy.fixed,
     default_qty_value        = 1,
     commission_type          = strategy.commission.cash_per_order,
     commission_value         = 3.5,   // $ لكل صفقة — عدّلها حسب بروكرك
     slippage                 = 2,
     pyramiding               = 0,
     calc_on_every_tick       = false,
     process_orders_on_close  = true,
     max_labels_count         = 200)

// ── المدخلات (نفس أسماء المؤشر) ───────────────────────────────────────────
G1 = "① الميكروستركشر"
sigLen    = input.int  (20,   "σ للعوائد — نافذة BVC",       minval=5,  maxval=200, group=G1)
bucketLen = input.int  (20,   "متوسط الحجم — نافذة",         minval=5,  maxval=200, group=G1)
bucketMul = input.float(0.5,  "حجم الدلو (× متوسط الشمعة)",  minval=0.05, maxval=5.0, step=0.05, group=G1)
vpinWin   = input.int  (50,   "عدد الدِلاء في نافذة VPIN",   minval=10, maxval=200, group=G1)
ofiLen    = input.int  (20,   "نافذة OFI",                   minval=5,  maxval=200, group=G1)
lamLen    = input.int  (30,   "نافذة Kyle λ",                minval=10, maxval=200, group=G1)
illLen    = input.int  (20,   "نافذة Amihud",                minval=5,  maxval=200, group=G1)

G2 = "② هندسة المعلومات"
hurstLen  = input.int  (100,  "نافذة Hurst",                 minval=30, maxval=500, group=G2)
peLen     = input.int  (60,   "نافذة Permutation Entropy",   minval=20, maxval=300, group=G2)
shLen     = input.int  (60,   "نافذة Shannon Entropy",       minval=20, maxval=300, group=G2)
erLen     = input.int  (20,   "نافذة Efficiency Ratio",      minval=5,  maxval=100, group=G2)
rankLen   = input.int  (150,  "نافذة Percentile Rank",       minval=50, maxval=500, group=G2)

G3 = "③ آلة الأنظمة"
hTrend    = input.float(0.53, "Hurst ≥ → ترند",              minval=0.50, maxval=0.70, step=0.01, group=G3)
hRevert   = input.float(0.47, "Hurst ≤ → ارتداد",            minval=0.30, maxval=0.50, step=0.01, group=G3)
peMax     = input.float(40.0, "رتبة الإنتروبي ≤ → ترند (%)", minval=5, maxval=95, group=G3)
peMin     = input.float(60.0, "رتبة الإنتروبي ≥ → ارتداد(%)",minval=5, maxval=95, group=G3)
erMin     = input.float(0.28, "ER ≥ → ترند",                 minval=0.05, maxval=0.90, step=0.01, group=G3)
confirmN  = input.int  (3,    "شموع تأكيد النظام",           minval=1,  maxval=20, group=G3)

G4 = "④ الزناد والفلتر"
amaLen    = input.int  (20,   "طول الخط المتكيّف",           minval=5,  maxval=100, group=G4)
entryWin  = input.int  (6,    "نافذة الدخول بعد الاختراق",   minval=0,  maxval=30, group=G4)
flowMin   = input.float(0.05, "أدنى تدفق مُوقّع",            minval=0.0,maxval=0.5, step=0.01, group=G4)
zRev      = input.float(2.0,  "حدّ الارتداد (z)",            minval=0.5,maxval=4.0, step=0.1, group=G4)
minMeta   = input.float(55.0, "أدنى Meta-Score",             minval=0,  maxval=95, group=G4)
atrZMax   = input.float(2.2,  "أقصى ATR-z",                  minval=0.5,maxval=5.0, step=0.1, group=G4)
shockZ    = input.float(2.5,  "ATR-z = صدمة ⇒ ممنوع",        minval=1.0,maxval=6.0, step=0.1, group=G4)

G5 = "⑤ الفريم الأكبر"
htfTf     = input.timeframe("240", "فريم الاتجاه",                       group=G5)
htfFlowOn = input.bool (true, "اشتراط توافق تدفق HTF",                   group=G5)

G6 = "⑥ إدارة الصفقة"
slMult    = input.float(1.6,  "الوقف (× ATR)",               minval=0.3,maxval=6.0, step=0.1, group=G6)
rr        = input.float(1.8,  "الهدف (R:R)",                 minval=0.5,maxval=6.0, step=0.1, group=G6)
maxBars   = input.int  (40,   "حدّ الوقت (شمعة)",            minval=5,  maxval=400, group=G6)
beAtR     = input.float(1.0,  "الوقف للدخول بعد (R)",        minval=0.0,maxval=3.0, step=0.1, group=G6)
riskPct   = input.float(1.0,  "المخاطرة في الصفقة (%)",      minval=0.1,maxval=5.0, step=0.1, group=G6)
contrVal  = input.float(100.0,"قيمة العقد (لعرض اللوتات)",   minval=1,  group=G6)

G7 = "⑦ الجلسات"
sessOn    = input.bool (true, "التداول داخل الجلسة دي بس",   group=G7)
sessStr   = input.session("0700-1630", "جلسة التداول (GMT)", group=G7)
blkOn     = input.bool (true, "حظر الرول أوفر 21:45–22:15 GMT", group=G7)

G8 = "⑧ الشكل"
showTbl   = input.bool (true, "جدول الملخص",                 group=G8)

// ── الدوال (مطابقة للمؤشر) ────────────────────────────────────────────────
f_erf(float x) =>
    float s  = x < 0 ? -1.0 : 1.0
    float ax = math.abs(x)
    float t  = 1.0 / (1.0 + 0.3275911 * ax)
    float y  = 1.0 - ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * math.exp(-ax * ax)
    s * y

f_ncdf(float z) => 0.5 * (1.0 + f_erf(z / math.sqrt(2.0)))

f_pctr(series float src, simple int len) =>
    float below = 0.0
    float tot   = 0.0
    for i = 0 to len - 1
        float v = src[i]
        if not na(v)
            tot += 1.0
            if v < src
                below += 1.0
    tot > 1 ? 100.0 * below / tot : na

f_hurst(simple int win) =>
    float p  = math.log(close)
    float v1 = ta.variance(p - p[1], win)
    float v2 = ta.variance(p - p[2], win)
    float v4 = ta.variance(p - p[4], win)
    float v8 = ta.variance(p - p[8], win)
    float h  = 0.5
    if v1 > 0 and v2 > 0 and v4 > 0 and v8 > 0
        float y1 = math.log(v2 / (2.0 * v1))
        float y2 = math.log(v4 / (4.0 * v1))
        float y3 = math.log(v8 / (8.0 * v1))
        float xm = 1.3862943611198906
        float ym = (y1 + y2 + y3) / 3.0
        float dx1 = 0.6931471805599453 - xm
        float dx2 = 1.3862943611198906 - xm
        float dx3 = 2.0794415416798359 - xm
        float sxx = dx1 * dx1 + dx2 * dx2 + dx3 * dx3
        float sxy = dx1 * (y1 - ym) + dx2 * (y2 - ym) + dx3 * (y3 - ym)
        if sxx > 0
            h := math.max(0.0, math.min(1.0, 0.5 * (sxy / sxx + 1.0)))
    h

f_permEntropy(series float r, simple int len) =>
    array<float> cnt = array.new<float>(8, 0.0)
    float used = 0.0
    for i = 0 to len - 1
        float a = r[i]
        float b = r[i + 1]
        float c = r[i + 2]
        if not na(a) and not na(b) and not na(c)
            int code = (a > b ? 1 : 0) + (a > c ? 2 : 0) + (b > c ? 4 : 0)
            array.set(cnt, code, array.get(cnt, code) + 1.0)
            used += 1.0
    float H = 0.0
    if used > 1
        for j = 0 to 7
            float p = array.get(cnt, j) / used
            if p > 0
                H -= p * math.log(p)
    H / 1.791759469228055

f_shannon(series float r, series float sd, simple int len) =>
    array<float> cnt = array.new<float>(8, 0.0)
    float used = 0.0
    for i = 0 to len - 1
        float v = r[i]
        float s = sd[i]
        if not na(v) and not na(s) and s > 0
            int b = int(math.floor(v / s + 4.0))
            b := math.max(0, math.min(7, b))
            array.set(cnt, b, array.get(cnt, b) + 1.0)
            used += 1.0
    float H = 0.0
    if used > 1
        for j = 0 to 7
            float p = array.get(cnt, j) / used
            if p > 0
                H -= p * math.log(p)
    H / 2.0794415416798359

f_er(simple int len) =>
    float net  = math.abs(close - close[len])
    float path = ta.sum(math.abs(close - close[1]), len)
    path > 0 ? net / path : 0.0

f_ama(simple int len, simple int fast, simple int slow) =>
    float e1  = f_er(len)
    float fsc = 2.0 / (fast + 1.0)
    float ssc = 2.0 / (slow + 1.0)
    float a   = math.pow(e1 * (fsc - ssc) + ssc, 2)
    float out = na
    out := na(out[1]) ? close : a * close + (1.0 - a) * nz(out[1])
    out

f_csSpread() =>
    float hl0 = high / low
    float hl1 = high[1] / low[1]
    float s   = 0.0
    if hl0 > 1.0 and hl1 > 1.0
        float beta  = 3.8284271247461903 * (math.log(hl0) * math.log(hl0) + math.log(hl1) * math.log(hl1))
        float gamma = math.log(high / low[1])
        gamma := gamma * gamma
        float den   = 0.1715728752538099
        float alpha = (math.sqrt(2.0 * beta) - math.sqrt(beta)) / den - math.sqrt(beta / den) + math.sqrt(gamma / den)
        float ea    = math.exp(alpha)
        s := math.max(0.0, math.min(1.0, 2.0 * (ea - 1.0) / (1.0 + ea)))
    s

f1(float v) => na(v) ? "—" : str.tostring(v, "#.#")
f2(float v) => na(v) ? "—" : str.tostring(v, "#.##")
f3(float v) => na(v) ? "—" : str.tostring(v, "#.###")

// ── الطبقة 0 ─────────────────────────────────────────────────────────────
float ret  = math.log(close / close[1])
float sig  = math.max(1e-10, ta.stdev(ret, sigLen))
float zRet = sig > 0 ? ret / sig : 0.0
float buyVol  = volume * f_ncdf(zRet)
float sellVol = volume - buyVol
float sgnVol  = buyVol - sellVol

float bktSize = math.max(1.0, nz(ta.sma(volume, bucketLen)) * bucketMul)
var float accB = 0.0
var float accS = 0.0
var float accV = 0.0
var array<float> qB = array.new<float>()
var array<float> qS = array.new<float>()

float remB = buyVol
float remS = sellVol
int   guard = 0
while guard < 8 and (remB + remS) > 0
    float inc  = remB + remS
    float take = math.min(bktSize - accV, inc)
    float frac = inc > 0 ? take / inc : 0.0
    accB += remB * frac
    accS += remS * frac
    remB -= remB * frac
    remS -= remS * frac
    accV += take
    if accV >= bktSize * 0.999999
        array.push(qB, accB)
        array.push(qS, accS)
        accB := 0.0
        accS := 0.0
        accV := 0.0
        if array.size(qB) > vpinWin
            array.shift(qB)
            array.shift(qS)
    guard += 1

float vpinAbs = na
float vpinSig = na
if array.size(qB) >= vpinWin
    float tb  = array.sum(qB)
    float ts  = array.sum(qS)
    float tv  = tb + ts
    float imb = 0.0
    for i = 0 to array.size(qB) - 1
        imb += math.abs(array.get(qB, i) - array.get(qS, i))
    if tv > 0
        vpinAbs := imb / tv
        vpinSig := (tb - ts) / tv

float tvol  = ta.sum(volume,  ofiLen)
float tBuy  = ta.sum(buyVol,  ofiLen)
float tSell = ta.sum(sellVol, ofiLen)
float flow  = tvol > 0 ? (tBuy - tSell) / tvol : 0.0

float lamVar = ta.variance(sgnVol, lamLen)
float lamCov = ta.covariance(close - open, sgnVol, lamLen)
float lam    = lamVar > 0 ? lamCov / lamVar : na
float lamBps = na(lam) ? na : lam * close * 10000.0

float illiq = ta.sma(math.abs(ret) / math.max(close * volume, 1e-9), illLen)
float sprBp = f_csSpread() * 10000.0
float atr   = ta.atr(14)
float atrS  = ta.sma(atr, 100)
float atrSd = ta.stdev(atr, 100)
float atrZ  = atrSd > 0 ? (atr - atrS) / atrSd : 0.0

// ── الطبقة 1 ─────────────────────────────────────────────────────────────
float hurst = f_hurst(hurstLen)
float pe    = f_permEntropy(ret, peLen)
float sh    = f_shannon(ret, sig, shLen)
float er    = f_er(erLen)

float rPe   = f_pctr(pe,      rankLen)
float rEr   = f_pctr(er,      rankLen)
float rVabs = f_pctr(vpinAbs, rankLen)
float rSpr  = f_pctr(sprBp,   rankLen)
float rIll  = f_pctr(illiq,   rankLen)
float rLam  = f_pctr(math.abs(lam), rankLen)

// ── الطبقة 2 ─────────────────────────────────────────────────────────────
f_htfPack() =>
    float r1  = math.log(close[1] / close[2])
    float sd  = ta.stdev(r1, sigLen)
    float bv  = volume[1] * f_ncdf(sd > 0 ? r1 / sd : 0.0)
    float fl  = volume[1] > 0 ? (2.0 * bv - volume[1]) / volume[1] : 0.0
    float net = math.abs(close[1] - close[1 + erLen])
    float pth = ta.sum(math.abs(close[1] - close[2]), erLen)
    float e   = pth > 0 ? net / pth : 0.0
    float sl  = ta.ema(close[1], 20) - ta.ema(close[1], 50)
    [fl, e, sl]

[htfFlow, htfEr, htfSlope] = request.security(syminfo.tickerid, htfTf, f_htfPack(), barmerge.gaps_off, barmerge.lookahead_on)

float amaLine = f_ama(amaLen, 2, 30)
float zres    = atr > 0 ? (close - amaLine) / atr : na

var int state = 0
var int cand  = 0
var int run   = 0
int rawState = 0
if not na(hurst) and not na(rPe) and not na(er)
    if hurst >= hTrend and rPe <= peMax and er >= erMin
        rawState := 1
    else if hurst <= hRevert and rPe >= peMin and er < erMin
        rawState := -1

if rawState == state
    cand := state
    run  := 0
else
    if rawState == cand
        run += 1
    else
        cand := rawState
        run  := 1
    if run >= confirmN
        state := cand
        run   := 0

// ── الطبقة 3 ─────────────────────────────────────────────────────────────
bool crossUp = ta.crossover(close, amaLine)
bool crossDn = ta.crossunder(close, amaLine)
int  sinceUp = ta.barssince(crossUp)
int  sinceDn = ta.barssince(crossDn)

int sigDir = 0
if state == 1 and not na(sinceUp) and sinceUp <= entryWin and close > amaLine and not na(vpinSig) and vpinSig > flowMin
    sigDir := 1
else if state == -1 and not na(sinceDn) and sinceDn <= entryWin and close < amaLine and not na(vpinSig) and vpinSig < -flowMin
    sigDir := -1
else if state == -1 and not na(zres) and zres < -zRev
    sigDir := 1
else if state == -1 and not na(zres) and zres > zRev
    sigDir := -1

// ── الطبقة 4 ─────────────────────────────────────────────────────────────
int   hh    = hour(time, "GMT")
int   mm    = minute(time, "GMT")
bool blk    = blkOn and ((hh == 21 and mm >= 45) or (hh == 22 and mm < 15))
bool inSess = sessOn ? not na(time(timeframe.period, sessStr, "GMT")) : true
bool sessOk = inSess and not blk
bool shock  = atrZ > shockZ

f_meta(int mode, float vSig, float vAbsP, float sprP, float illP, float lamP, float aZ, float erP, bool hOk, bool sOk, bool shk) =>
    float sc = 0.0
    if mode != 0 and sOk and not shk
        float fl = 50.0 + 50.0 * math.max(-1.0, math.min(1.0, vSig))
        fl := mode < 0 ? 100.0 - fl : fl
        float erc = mode > 0 ? erP : 100.0 - erP
        float liq = 100.0 - (0.45 * sprP + 0.30 * illP + 0.25 * lamP)
        float vol = math.max(0.0, 100.0 - 45.0 * math.abs(aZ))
        sc := 0.30 * fl + 0.22 * erc + 0.18 * liq + 0.12 * vol + 0.18 * (hOk ? 100.0 : 0.0)
        if vAbsP > 97.0
            sc *= 0.5
    math.max(0.0, math.min(100.0, sc))

bool htfOk = not htfFlowOn or na(htfFlow) or (sigDir > 0 ? htfFlow > 0 : htfFlow < 0)
float meta = f_meta(state, nz(vpinSig), nz(rVabs), nz(rSpr), nz(rIll), nz(rLam), atrZ, nz(rEr), htfOk, sessOk, shock)

bool goLong  = sigDir ==  1 and meta >= minMeta and math.abs(atrZ) <= atrZMax
bool goShort = sigDir == -1 and meta >= minMeta and math.abs(atrZ) <= atrZMax

// ── الطبقة 5: التنفيذ ─────────────────────────────────────────────────────
float slDist = atr * slMult
float equity = strategy.equity > 0 ? strategy.equity : strategy.initial_capital
float riskAmt = equity * riskPct / 100.0
float units   = slDist > 0 ? riskAmt / slDist : 0.0
float lots    = units / contrVal

bool flat = strategy.position_size == 0

if flat and goLong and units > 0
    strategy.entry("L", strategy.long, qty = units, comment = "QFL·L " + f1(meta))
if flat and goShort and units > 0
    strategy.entry("S", strategy.short, qty = units, comment = "QFL·S " + f1(meta))

// الحواجز الثلاثة
if strategy.position_size > 0
    float ep = strategy.position_avg_price
    float st = ep - slDist
    float tg = ep + slDist * rr
    float fav = (high - ep)
    if beAtR > 0 and fav >= slDist * beAtR
        st := ep
    strategy.exit("xL", from_entry = "L", stop = st, limit = tg, comment_loss = "SL", comment_profit = "TP")
    if bar_index - strategy.opentrades.entry_bar_index(strategy.opentrades - 1) >= maxBars
        strategy.close("L", comment = "TIME")

if strategy.position_size < 0
    float ep = strategy.position_avg_price
    float st = ep + slDist
    float tg = ep - slDist * rr
    float fav = ep - low
    if beAtR > 0 and fav >= slDist * beAtR
        st := ep
    strategy.exit("xS", from_entry = "S", stop = st, limit = tg, comment_loss = "SL", comment_profit = "TP")
    if bar_index - strategy.opentrades.entry_bar_index(strategy.opentrades - 1) >= maxBars
        strategy.close("S", comment = "TIME")

// ── الشكل ─────────────────────────────────────────────────────────────────
color cTrend = color.new(#00e5ff, 0)
color cRev   = color.new(#ff9f1c, 0)
color cIdle  = color.new(#7a8699, 0)
plot(amaLine, "الخط المتكيّف", state == 1 ? cTrend : state == -1 ? cRev : cIdle, 2)
bgcolor(state == 1 ? color.new(cTrend, 94) : state == -1 ? color.new(cRev, 94) : na)
plotshape(goLong  and flat, "شراء", shape.triangleup,   location.belowbar, color.new(#26ff8c, 0), size = size.small)
plotshape(goShort and flat, "بيع",  shape.triangledown, location.abovebar, color.new(#ff4d6d, 0), size = size.small)

float nf = strategy.closedtrades > 0 ? strategy.netprofit / strategy.closedtrades : 0.0
float wr = strategy.closedtrades > 0 ? 100.0 * strategy.closedtrades.win / strategy.closedtrades : 0.0
float dd = strategy.initial_capital > 0 ? 100.0 * strategy.max_drawdown / strategy.initial_capital : 0.0

var table tb = table.new(position.top_right, 2, 9,
     bgcolor = color.new(#070b14, 8), border_color = color.new(#1d2a44, 30),
     border_width = 1, frame_color = color.new(#2b6cff, 40), frame_width = 2)

if showTbl and barstate.islast
    table.cell(tb, 0, 0, "QFlow STRAT", text_color = cTrend, bgcolor = color.new(#0b1220, 0), text_size = size.small)
    table.cell(tb, 1, 0, state == 1 ? "TREND" : state == -1 ? "REVERT" : "NOISE", text_color = state == 1 ? cTrend : state == -1 ? cRev : cIdle, bgcolor = color.new(#0b1220, 0), text_size = size.small)
    table.cell(tb, 0, 1, "Hurst / رتبة الإنتروبي", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(tb, 1, 1, f3(hurst) + "  /  " + f1(rPe) + "%", text_color = color.white, bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(tb, 0, 2, "VPIN اتجاه / سمّية", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(tb, 1, 2, f3(vpinSig) + "  /  " + f3(vpinAbs), text_color = color.white, bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(tb, 0, 3, "META", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(tb, 1, 3, f1(meta) + " / 100", text_color = meta >= minMeta ? color.new(#26ff8c, 0) : color.white, bgcolor = color.new(#0d1526, 0), text_size = size.tiny)
    table.cell(tb, 0, 4, "الحجم", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#101a2e, 0), text_size = size.tiny)
    table.cell(tb, 1, 4, f3(lots) + " lot · مخاطرة $" + f1(riskAmt), text_color = color.new(#ffd166, 0), bgcolor = color.new(#101a2e, 0), text_size = size.tiny)
    table.cell(tb, 0, 5, "صفقات / نجاح", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#101a2e, 0), text_size = size.tiny)
    table.cell(tb, 1, 5, str.tostring(strategy.closedtrades) + "  /  " + f1(wr) + "%", text_color = color.white, bgcolor = color.new(#101a2e, 0), text_size = size.tiny)
    table.cell(tb, 0, 6, "متوسط الصفقة", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#101a2e, 0), text_size = size.tiny)
    table.cell(tb, 1, 6, "$" + f2(nf), text_color = nf > 0 ? color.new(#26ff8c, 0) : color.new(#ff4d6d, 0), bgcolor = color.new(#101a2e, 0), text_size = size.tiny)
    table.cell(tb, 0, 7, "صافي / Profit Factor", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#101a2e, 0), text_size = size.tiny)
    table.cell(tb, 1, 7, "$" + f2(strategy.netprofit) + "  /  " + f2(strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : 0.0), text_color = color.white, bgcolor = color.new(#101a2e, 0), text_size = size.tiny)
    table.cell(tb, 0, 8, "أقصى تراجع", text_color = color.new(#6f86b8, 0), bgcolor = color.new(#101a2e, 0), text_size = size.tiny)
    table.cell(tb, 1, 8, f1(dd) + "%", text_color = color.new(#ffd166, 0), bgcolor = color.new(#101a2e, 0), text_size = size.tiny)
