//@version=5
indicator("APEX QUANTUM NEXUS [INSTITUTIONAL ALPHA & SMC ENGINE]", "QUANTUM ⚡ ALPHA", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ═══════════════════════════════════════════════════════════════════
//  المفاهيم السرية والمؤسساتية المستخدمة (بدون مؤشرات تقليدية ضعيفة):
//  1) Wyckoff Spring & Upthrust : أنماط التجميع والتوزيع السرية (اصطياد الستوبات الخفية)
//  2) Multi-Timeframe HTF Confluence : مطابقة هيكل الفريمات الكبرى (Daily/4H) مع التنفيذ
//  3) Volatility Squeeze & Expansion : اكتشاف انضغاط التقلب قبل الانفجارات السعرية الكبرى
//  4) Institutional Liquidity Sweep : اصطياد السيولة العمياء فوق وتحت القمم المتساوية
//  5) Smart Money Order Blocks & FVG : مناطق المؤسسات وفجوات عدم التوازن المصفاة بالدلتا
//  6) Institutional Delta Volume Matrix : قياس ضغط الحجم الحقيقي (Buy/Sell Pressure)
//  7) Dynamic Risk & Multi-Targets : إدارة مخاطر متقدمة مع 3 أهداف متدرجة (TP1, TP2, TP3)
// ═══════════════════════════════════════════════════════════════════

// ───────────── INPUTS & CONFIGURATION ─────────────
grpS = "⚙️ الهيكل السعري المؤسساتي (SMC)"
swLen    = input.int(8,   "حساسية القمم/القيعان (Swing Len)", minval = 2, group = grpS)
showBOS  = input.bool(true, "إظهار BOS / CHoCH الهيكلي", group = grpS)
htfTF    = input.timeframe("240", "فريم التأكيد العالي (HTF Confluence)", group = grpS)

grpW = "🕵️‍♂️ أنماط وايكوف السرية (Wyckoff Spring & Upthrust)"
showWyk  = input.bool(true, "تفعيل كشف Spring & Upthrust", group = grpW)
wykLook  = input.int(20, "فترة نطاق وايكوف (Range Lookback)", minval = 10, group = grpW)

grpL = "💧 مصفوفة السيولة واصطياد الستوبات"
eqTol    = input.float(0.06, "تسامح القمم المتساوية (× ATR)", step = 0.01, group = grpL)
showLiq  = input.bool(true, "إظهار مسابح السيولة والاصطياد (Sweeps)", group = grpL)

grpO = "📦 الأوردر بلوك (OB) وفجوات (FVG)"
showOB   = input.bool(true, "Institutional Order Blocks", group = grpO)
showFVG  = input.bool(true, "Fair Value Gaps (FVG)", group = grpO)
obMax    = input.int(5, "الحد الأقصى للـ OB الظاهرة", minval = 1, maxval = 15, group = grpO)
mitigate = input.bool(true, "إزالة المناطق عند اختبارها/اختراقها", group = grpO)

grpV = "⚡ فلتر التقلب (Volatility Squeeze) والدلتا"
useSqueeze = input.bool(true, "فلتر انضغاط التقلب (BB/KC Squeeze)", group = grpV)
useDelta   = input.bool(true, "فلتر ضغط الدلتا الحجمية", group = grpV)
minScore   = input.int(4, "أقل درجة اعتماد للإشارة (0 إلى 7)", minval = 1, maxval = 7, group = grpV)

grpR = "🛡️ إدارة المخاطر المتقدمة والأهداف"
atrMult  = input.float(1.2, "وقف الخسارة ATR Multiplier", step = 0.1, group = grpR)
rr1      = input.float(1.5, "الهدف الأول R:R", step = 0.5, group = grpR)
rr2      = input.float(2.5, "الهدف الثاني R:R", step = 0.5, group = grpR)
rr3      = input.float(4.0, "الهدف الثالث R:R (الطموح)", step = 0.5, group = grpR)

grpTheme = "🎨 الألوان والمظهر"
cBull    = input.color(#00FFC4, "لون الصعود المؤسساتي", group = grpTheme)
cBear    = input.color(#FF2A6D, "لون الهبوط المؤسساتي", group = grpTheme)
showDash = input.bool(true, "إظهار لوحة التحكم الكمية (Dashboard)", group = grpTheme)

// ───────────── CORE ENGINE & INDICATORS ─────────────
atr = ta.atr(14)
volumeEMA = ta.ema(volume, 20)
highVol = volume > volumeEMA * 1.3

// Swing points (Market Structure)
ph = ta.pivothigh(high, swLen, swLen)
pl = ta.pivotlow (low,  swLen, swLen)

var float lastPH   = na
var float lastPL   = na
var float prevPH   = na
var float prevPL   = na

if not na(ph)
    prevPH := lastPH
    lastPH := ph
if not na(pl)
    prevPL := lastPL
    lastPL := pl

// Trend State & BOS / CHoCH
var int trend = 0 
var bool bosUp = false, var bool bosDn = false, var bool chochUp = false, var bool chochDn = false
bosUp := false, bosDn := false, chochUp := false, chochDn := false

if not na(lastPH) and ta.crossover(close, lastPH)
    if trend == -1
        chochUp := true
    else
        bosUp := true
    trend := 1
    lastPH := na

if not na(lastPL) and ta.crossunder(close, lastPL)
    if trend == 1
        chochDn := true
    else
        bosDn := true
    trend := -1
    lastPL := na

// Higher Timeframe (HTF) Confluence Structure
htfClose = request.security(syminfo.tickerid, htfTF, close, barmerge.lookahead_off, barmerge.gaps_off)
htfOpen  = request.security(syminfo.tickerid, htfTF, open, barmerge.lookahead_off, barmerge.gaps_off)
htfBull  = htfClose > htfOpen
htfBear  = htfClose < htfOpen

// ───────────── 1) WYCKOFF SPRING & UPTHRUST PATTERNS (سر صناديق الاستثمار) ─────────────
rangeLow  = ta.lowest(low, wykLook)
rangeHigh = ta.highest(high, wykLook)

wykSpring   = low < rangeLow[1] and close > rangeLow[1] and highVol and (close - low) > (high - close) * 1.5
wykUpthrust = high > rangeHigh[1] and close < rangeHigh[1] and highVol and (high - close) > (close - low) * 1.5

// ───────────── 2) LIQUIDITY SWEEP & EQUAL HIGHS/LOWS ─────────────
sweepHi = not na(prevPH) and high > prevPH and close < prevPH
sweepLo = not na(prevPL) and low  < prevPL and close > prevPL

eqH = not na(lastPH) and not na(prevPH) and math.abs(lastPH - prevPH) <= eqTol * atr
eqL = not na(lastPL) and not na(prevPL) and math.abs(lastPL - prevPL) <= eqTol * atr

// ───────────── 3) VOLATILITY SQUEEZE (Bollinger Bands & Keltner Channels) ─────────────
basis = ta.sma(close, 20)
dev = 2.0 * ta.stdev(close, 20)
upperBB = basis + dev
lowerBB = basis - dev

keltnerATR = ta.atr(20)
upperKC = basis + (1.5 * keltnerATR)
lowerKC = basis - (1.5 * keltnerATR)

isSqueeze = (upperBB < upperKC) and (lowerBB > lowerKC)
wasSqueeze = ta.barssince(not isSqueeze) <= 3
squeezeBreakoutUp   = wasSqueeze and ta.crossover(close, upperBB)
squeezeBreakoutDown = wasSqueeze and ta.crossunder(close, lowerBB)

// ───────────── 4) INSTITUTIONAL DELTA VOLUME MATRIX ─────────────
rng    = math.max(high - low, syminfo.mintick)
buyV   = volume * (close - low)  / rng
sellV  = volume * (high - close) / rng
delta  = buyV - sellV
dNorm  = ta.ema(delta, 14) / math.max(ta.ema(volume, 14), 1)
bullDelta = dNorm > 0.03
bearDelta = dNorm < -0.03

// ───────────── 5) FAIR VALUE GAPS (FVG) ─────────────
type FVG
    float top
    float bot
    int   dir
    box   bx

var array<FVG> fvgs = array.new<FVG>()
bullFVG = low > high[2] and close[1] > open[1]
bearFVG = high < low[2] and close[1] < open[1]

if showFVG and bullFVG
    b = box.new(bar_index - 2, low, bar_index + 12, high[2], border_color = color.new(cBull, 50), bgcolor = color.new(cBull, 88))
    array.push(fvgs, FVG.new(low, high[2], 1, b))
if showFVG and bearFVG
    b = box.new(bar_index - 2, low[2], bar_index + 12, high, border_color = color.new(cBear, 50), bgcolor = color.new(cBear, 88))
    array.push(fvgs, FVG.new(low[2], high, -1, b))

if array.size(fvgs) > 0
    for i = array.size(fvgs) - 1 to 0
        f = array.get(fvgs, i)
        filled = f.dir == 1 ? close < f.bot : close > f.top
        if mitigate and filled
            box.delete(f.bx)
            array.remove(fvgs, i)
        else
            box.set_right(f.bx, bar_index + 12)
        if array.size(fvgs) > 25
            g = array.shift(fvgs)
            box.delete(g.bx)

// ───────────── 6) ORDER BLOCKS (OB) ─────────────
type OB
    float top
    float bot
    int   dir
    box   bx
    label lb

var array<OB> obs = array.new<OB>()
impulse = math.abs(close - open) > atr * 0.85

newBullOB = impulse and close > open and close[1] < open[1] and (bosUp or chochUp or bullFVG or wykSpring)
newBearOB = impulse and close < open and close[1] > open[1] and (bosDn or chochDn or bearFVG or wykUpthrust)

if showOB and newBullOB
    t = math.max(open[1], close[1]), bt = low[1]
    b = box.new(bar_index - 1, t, bar_index + 15, bt, border_color = cBull, bgcolor = color.new(cBull, 82))
    l = label.new(bar_index + 15, t, "QUANTUM OB+", style = label.style_label_left, color = color.new(cBull, 20), textcolor = color.white, size = size.tiny)
    array.push(obs, OB.new(t, bt, 1, b, l))

if showOB and newBearOB
    t = high[1], bt = math.min(open[1], close[1])
    b = box.new(bar_index - 1, t, bar_index + 15, bt, border_color = cBear, bgcolor = color.new(cBear, 82))
    l = label.new(bar_index + 15, bt, "QUANTUM OB-", style = label.style_label_left, color = color.new(cBear, 20), textcolor = color.white, size = size.tiny)
    array.push(obs, OB.new(t, bt, -1, b, l))

var bool obTapBull = false
var bool obTapBear = false
obTapBull := false
obTapBear := false

if array.size(obs) > 0
    for i = array.size(obs) - 1 to 0
        o = array.get(obs, i)
        if o.dir == 1 and low <= o.top and high >= o.bot
            obTapBull := true
        if o.dir == -1 and high >= o.bot and low <= o.top
            obTapBear := true
        broken = o.dir == 1 ? close < o.bot : close > o.top
        if mitigate and broken
            box.delete(o.bx), label.delete(o.lb)
            array.remove(obs, i)
        else
            box.set_right(o.bx, bar_index + 15)
            label.set_x(o.lb, bar_index + 15)
        if array.size(obs) > obMax
            g = array.shift(obs)
            box.delete(g.bx), label.delete(g.lb)

// ───────────── 7) QUANTUM SCORING MATRIX (0 - 7) ─────────────
scoreLong  = 0
scoreShort = 0

scoreLong  += (chochUp or bosUp) ? 1 : 0
scoreShort += (chochDn or bosDn) ? 1 : 0

scoreLong  += (showWyk and wykSpring) ? 1 : 0
scoreShort += (showWyk and wykUpthrust) ? 1 : 0

scoreLong  += sweepLo ? 1 : 0
scoreShort += sweepHi ? 1 : 0

scoreLong  += (obTapBull or bullFVG) ? 1 : 0
scoreShort += (obTapBear or bearFVG) ? 1 : 0

scoreLong  += htfBull ? 1 : 0
scoreShort += htfBear ? 1 : 0

scoreLong  += (not useSqueeze or squeezeBreakoutUp or trend == 1) ? 1 : 0
scoreShort += (not useSqueeze or squeezeBreakoutDown or trend == -1) ? 1 : 0

scoreLong  += (not useDelta or bullDelta) ? 1 : 0
scoreShort += (not useDelta or bearDelta) ? 1 : 0

var int lastSigBar = -999
cooldown = bar_index - lastSigBar > 6

longSig  = scoreLong  >= minScore and scoreLong  > scoreShort  and cooldown
shortSig = scoreShort >= minScore and scoreShort > scoreLong   and cooldown

// ───────────── ENTRY, STOP LOSS & MULTI-TARGETS ─────────────
var float ePrice = na
var float sl     = na
var float tp1    = na
var float tp2    = na
var float tp3    = na

if longSig
    ePrice := close
    sl     := close - (atr * atrMult)
    tp1    := close + (atr * atrMult * rr1)
    tp2    := close + (atr * atrMult * rr2)
    tp3    := close + (atr * atrMult * rr3)
    lastSigBar := bar_index

if shortSig
    ePrice := close
    sl     := close + (atr * atrMult)
    tp1    := close - (atr * atrMult * rr1)
    tp2    := close - (atr * atrMult * rr2)
    tp3    := close - (atr * atrMult * rr3)
    lastSigBar := bar_index

// ───────────── PLOTTING & VISUALIZATION ─────────────
plotshape(showBOS and bosUp,   "BOS 📈", shape.triangleup,   location.belowbar, cBull, size = size.tiny, text = "BOS+")
plotshape(showBOS and bosDn,   "BOS 📉", shape.triangledown, location.abovebar, cBear, size = size.tiny, text = "BOS-")
plotshape(showBOS and chochUp, "CHoCH 🚀", shape.diamond,    location.belowbar, color.new(cBull, 10), size = size.small, text = "CHoCH+")
plotshape(showBOS and chochDn, "CHoCH 🩸", shape.diamond,    location.abovebar, color.new(cBear, 10), size = size.small, text = "CHoCH-")

plotshape(showWyk and wykSpring,   "Wyckoff Spring ⚡", shape.labelup,   location.belowbar, color.yellow, size = size.normal, text = "SPRING ⚡", textcolor = color.black)
plotshape(showWyk and wykUpthrust, "Wyckoff Upthrust ⚡", shape.labeldown, location.abovebar, color.orange, size = size.normal, text = "UPTHRUST ⚡", textcolor = color.black)

plotshape(showLiq and sweepLo, "Sweep Low 💧", shape.xcross, location.belowbar, color.yellow, size = size.tiny, text = "LIQ+")
plotshape(showLiq and sweepHi, "Sweep High 💧", shape.xcross, location.abovebar, color.orange, size = size.tiny, text = "LIQ-")

plotshape(longSig,  "QUANTUM BUY",  shape.labelup,   location.belowbar, cBull, text = "QUANTUM BUY ⚡", textcolor = color.black, size = size.large)
plotshape(shortSig, "QUANTUM SELL", shape.labeldown, location.abovebar, cBear, text = "QUANTUM SELL ⚡", textcolor = color.white, size = size.large)

// Trade Lines
plot(na(ePrice) ? na : ePrice, "Quantum Entry", color.new(color.gray, 20), 2, plot.style_linebr)
plot(na(sl)     ? na : sl,     "Stop Loss",     cBear, 2, plot.style_linebr)
plot(na(tp1)    ? na : tp1,    "TP1 (1.5R)",    color.new(cBull, 50), 1, plot.style_linebr)
plot(na(tp2)    ? na : tp2,    "TP2 (2.5R)",    color.new(cBull, 25), 1, plot.style_linebr)
plot(na(tp3)    ? na : tp3,    "TP3 (4.0R)",    cBull, 2, plot.style_linebr)

// ───────────── QUANTUM DASHBOARD ─────────────
if showDash and barstate.islast
    var table d = table.new(position.top_right, 2, 8, border_width = 1)
    table.cell(d, 0, 0, "QUANTUM ALPHA ⚡", bgcolor = color.new(color.black, 0), text_color = color.white, text_size = size.small)
    table.cell(d, 1, 0, timeframe.period + " | HTF: " + htfTF, bgcolor = color.new(color.black, 0), text_color = color.yellow, text_size = size.small)
    
    table.cell(d, 0, 1, "اتجاه الهيكل", text_size = size.tiny, text_color = color.gray)
    table.cell(d, 1, 1, trend == 1 ? "صاعد ▲" : trend == -1 ? "هابط ▼" : "متذبذب", text_color = trend == 1 ? cBull : trend == -1 ? cBear : color.gray, text_size = size.tiny)
    
    table.cell(d, 0, 2, "هيكل الفريم العالي", text_size = size.tiny, text_color = color.gray)
    table.cell(d, 1, 2, htfBull ? "إيجابي 🟢" : "سلبي 🔴", text_color = htfBull ? cBull : cBear, text_size = size.tiny)
    
    table.cell(d, 0, 3, "انضغاط السqueeze", text_size = size.tiny, text_color = color.gray)
    table.cell(d, 1, 3, isSqueeze ? "منضغط (انفجار قريب) ⚡" : "عادي", text_color = isSqueeze ? color.yellow : color.gray, text_size = size.tiny)
    
    table.cell(d, 0, 4, "ضغط الدلتا", text_size = size.tiny, text_color = color.gray)
    table.cell(d, 1, 4, str.tostring(dNorm * 100, "#.1") + "%", text_color = dNorm > 0 ? cBull : cBear, text_size = size.tiny)
    
    table.cell(d, 0, 5, "نقاط قوة الشراء", text_size = size.tiny, text_color = color.gray)
    table.cell(d, 1, 5, str.tostring(scoreLong) + "/7", text_color = cBull, text_size = size.tiny)
    
    table.cell(d, 0, 6, "نقاط قوة البيع", text_size = size.tiny, text_color = color.gray)
    table.cell(d, 1, 6, str.tostring(scoreShort) + "/7", text_color = cBear, text_size = size.tiny)
    
    table.cell(d, 0, 7, "حالة السوق", text_size = size.tiny, text_color = color.gray)
    table.cell(d, 1, 7, wykSpring ? "Wyckoff Spring ⚡" : wykUpthrust ? "Wyckoff Upthrust ⚡" : "مستقر", text_color = color.yellow, text_size = size.tiny)

// ───────────── ALERTS ─────────────
alertcondition(longSig,  "QUANTUM BUY",  "⚡ QUANTUM ALPHA: إشارة شراء قوية | {{ticker}} على فريم {{interval}} @ {{close}}")
alertcondition(shortSig, "QUANTUM SELL", "⚡ QUANTUM ALPHA: إشارة بيع قوية | {{ticker}} على فريم {{interval}} @ {{close}}")
alertcondition(wykSpring,   "Wyckoff Spring", "🕵️‍♂️ اكتشاف نمط وايكوف السري (Spring) | {{ticker}}")
alertcondition(wykUpthrust, "Wyckoff Upthrust", "🕵️‍♂️ اكتشاف نمط وايكوف السري (Upthrust) | {{ticker}}")
alertcondition(sweepHi,     "Liquidity Sweep", "💧 تم اصطياد السيولة العلوية (Stop Hunt) | {{ticker}}")
alertcondition(sweepLo,     "Liquidity Sweep", "💧 تم اصطياد السيولة السفلية (Stop Hunt) | {{ticker}}")
